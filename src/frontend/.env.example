# ============================================
# URL da API Backend
# ============================================
# URL base do backend Express (sem /api)
# IMPORTANTE: O backend roda na porta 3000
# O frontend roda na porta 3001 para evitar conflito
# Exemplo local: http://localhost:3000
# Exemplo produção: http://159.223.199.233:3000
NEXT_PUBLIC_API_URL=http://localhost:3000

# ============================================
# Configuração do Broker MQTT (WebSocket)
# ============================================
# URL do broker MQTT via WebSocket
# Para HiveMQ Cloud com SSL: wss://[seu-broker].s1.eu.hivemq.cloud:8884
# Para HiveMQ Cloud sem SSL: ws://[seu-broker].s1.eu.hivemq.cloud:8883
# Exemplo local: ws://localhost:8083
# Exemplo HiveMQ Cloud: wss://d8375c5d1154430bbaedae91fd4e1632.s1.eu.hivemq.cloud:8884/mqtt
NEXT_PUBLIC_MQTT_URL=wss://d8375c5d1154430bbaedae91fd4e1632.s1.eu.hivemq.cloud:8884/mqtt
# ============================================
# Credenciais MQTT (opcional, mas recomendado)
# ============================================
# Username para autenticação no broker MQTT
NEXT_PUBLIC_MQTT_USERNAME="Username aqui"

# Password para autenticação no broker MQTT
NEXT_PUBLIC_MQTT_PASSWORD="Senha aqui"
